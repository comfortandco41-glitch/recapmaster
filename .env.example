# Database configuration (Local SQLite for dev/test, PostgreSQL for production)
DATABASE_URL="file:./prisma/dev.db"
# Production PostgreSQL / Supabase example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/promovie?schema=public"

# Redis queue
REDIS_URL="redis://localhost:6379"

# Object Storage (S3 / Cloudflare R2 / Supabase Storage)
STORAGE_BUCKET="promovie-temp"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# External VoxCPM 2 Provider (Google Colab or dedicated inference server)
VOXCPM_ENDPOINT="http://localhost:8000"
VOXCPM_API_KEY=""
VOXCPM_TIMEOUT_SECONDS=300

# Limits and safety thresholds
MAX_SOURCE_SIZE_MB=2000
MAX_VIDEO_DURATION_SECONDS=7200
MAX_OUTPUT_SIZE_MB=2000
MAX_CONCURRENT_JOBS=2
JOB_TTL_MINUTES=60
